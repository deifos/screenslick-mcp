{
  "name": "screenslick-mcp",
  "version": "0.16.0",
  "description": "Local MCP server and Claude Video Studio helper for the ScreenSlick browser editor.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "screenslick-mcp": "dist/cli.js",
    "screenslick-studio": "dist/studio/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "template",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify:media": "tsx scripts/verify-media.ts",
    "verify:studio-release": "tsx scripts/verify-studio-release.ts",
    "verify:bridge-tools": "npm run build && tsx scripts/verify-bridge-tools.ts",
    "studio": "tsx src/studio/cli.ts",
    "sync:skill": "node scripts/sync-studio-skill.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "screenslick",
    "video",
    "screen-recording"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esbuild": "^0.28.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
