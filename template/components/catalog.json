[
  {
    "id": "prompt-box",
    "name": "Prompt Box",
    "category": "AI & Product",
    "description": "An AI chat input that types a request character by character, then presses send.",
    "useWhen": "Showing what a user asks an AI feature (\"make a launch video…\") right before the result appears; demos of chat, search or command bars.",
    "durationInFrames": 120,
    "layer": "overlay",
    "tags": [
      "ai",
      "prompt",
      "chat",
      "typing",
      "input",
      "search"
    ],
    "props": {
      "text": {
        "type": "text",
        "label": "Prompt",
        "default": "Make a 20 second launch video for my app",
        "multiline": true,
        "maxLength": 240
      },
      "placeholder": {
        "type": "text",
        "label": "Placeholder",
        "default": "Describe your video…"
      },
      "label": {
        "type": "text",
        "label": "Label",
        "default": "",
        "help": "Optional small line above the box."
      },
      "theme": {
        "type": "select",
        "label": "Theme",
        "default": "dark",
        "options": [
          {
            "value": "dark",
            "label": "Dark"
          },
          {
            "value": "light",
            "label": "Light"
          }
        ]
      },
      "accent": {
        "type": "color",
        "label": "Accent",
        "default": "#34d399"
      },
      "speed": {
        "type": "number",
        "label": "Typing speed",
        "default": 28,
        "min": 6,
        "max": 80,
        "step": 1,
        "unit": "chars/s"
      },
      "delay": {
        "type": "number",
        "label": "Start typing at",
        "default": 12,
        "min": 0,
        "max": 90,
        "step": 1,
        "unit": "frames"
      }
    },
    "examples": [
      {
        "name": "Dark",
        "props": {}
      },
      {
        "name": "Light search",
        "props": {
          "theme": "light",
          "text": "Find every clip where I mention pricing",
          "placeholder": "Search your recordings",
          "accent": "#6366f1"
        }
      },
      {
        "name": "With label",
        "props": {
          "label": "Motion Studio",
          "text": "Add a whoosh on every scene change and match the volume"
        }
      }
    ]
  },
  {
    "id": "stat-counter",
    "name": "Stat Counter",
    "category": "Charts & Stats",
    "description": "A big number that counts up to its value with a label, optionally inside a progress ring.",
    "useWhen": "Social proof and results: users, time saved, a percentage, revenue, a speed-up. One number per clip; put two side by side with two clips and boxes.",
    "durationInFrames": 90,
    "layer": "overlay",
    "tags": [
      "number",
      "metric",
      "kpi",
      "counter",
      "percentage",
      "social proof"
    ],
    "props": {
      "value": {
        "type": "number",
        "label": "Value",
        "default": 12000,
        "min": 0,
        "max": 100000000,
        "step": 1
      },
      "prefix": {
        "type": "text",
        "label": "Prefix",
        "default": "",
        "help": "e.g. $ or +"
      },
      "suffix": {
        "type": "text",
        "label": "Suffix",
        "default": "+",
        "help": "e.g. %, x, k. With % the ring fills to the value."
      },
      "decimals": {
        "type": "number",
        "label": "Decimals",
        "default": 0,
        "min": 0,
        "max": 2,
        "step": 1
      },
      "label": {
        "type": "text",
        "label": "Label",
        "default": "videos made this month"
      },
      "accent": {
        "type": "color",
        "label": "Accent",
        "default": "#34d399"
      },
      "textColor": {
        "type": "color",
        "label": "Text",
        "default": "#ffffff"
      },
      "background": {
        "type": "color",
        "label": "Background",
        "default": "transparent"
      },
      "ring": {
        "type": "boolean",
        "label": "Progress ring",
        "default": false
      },
      "countFrames": {
        "type": "number",
        "label": "Count time",
        "default": 45,
        "min": 10,
        "max": 120,
        "step": 1,
        "unit": "frames"
      }
    },
    "examples": [
      {
        "name": "Users",
        "props": {}
      },
      {
        "name": "Percent ring",
        "props": {
          "value": 87,
          "suffix": "%",
          "label": "less time editing",
          "ring": true,
          "accent": "#60a5fa"
        }
      },
      {
        "name": "Revenue",
        "props": {
          "value": 2.4,
          "decimals": 1,
          "prefix": "$",
          "suffix": "M",
          "label": "saved in production costs",
          "background": "#0b0d10",
          "accent": "#f59e0b"
        }
      }
    ]
  },
  {
    "id": "lower-third",
